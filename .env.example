# Waypoint Autopilot — Environment Configuration

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Waypoint Autopilot"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# AI Provider Configuration (Local Open-Weight Inference)
# Options: "ollama" | "deterministic"
NEXT_PUBLIC_AI_PROVIDER=deterministic

# Ollama Endpoint Configuration (Used when NEXT_PUBLIC_AI_PROVIDER=ollama)
# Note: For local development, point to your local Ollama daemon.
# Never expose an unauthenticated Ollama endpoint to the public internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# OpenStreetMap / Overpass API Configuration (Public endpoint or custom mirror)
NEXT_PUBLIC_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NEXT_PUBLIC_OSRM_ROUTING_URL=https://router.project-osrm.org
